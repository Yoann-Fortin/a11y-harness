{
  "description": "Checks the accessibility of a React component after Claude writes or edits it, keeps the a11y-reviewer agent read-only, and sends back an answer that cites a criterion the audit did not open, rules on a form without an audit, or comes with tests that verify-tests never checked",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/a11y-check/main.ts\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reviewer-guard/main.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/answer-guard/main.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
