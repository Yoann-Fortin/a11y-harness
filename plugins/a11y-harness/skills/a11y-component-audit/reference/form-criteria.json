{
  "form": {
    "description": "Form, as the RGAA glossary defines it (« Formulaire »): a form element, or an element with role=\"form\"",
    "signals": [
      "<form",
      "role=[\"']form[\"']"
    ]
  },
  "elements": [
    {
      "id": "form-field",
      "description": "Form field, as the RGAA glossary defines it (« Champ de saisie de formulaire »)",
      "signals": [
        "<input(?![^>]*type=[\"'](?:submit|reset|button|image|hidden)[\"'])",
        "<(?:textarea|select|datalist|output|progress|meter)\\b",
        "role=[\"'](?:textbox|searchbox|combobox|listbox|checkbox|radio|switch|slider|spinbutton|progressbar)[\"']"
      ],
      "criteria": {
        "wcag-2.2": [
          "1.3.1",
          "2.4.6",
          "2.5.3",
          "3.3.2",
          "4.1.2"
        ],
        "rgaa-4.1.2": [
          "11.1",
          "11.2",
          "11.4"
        ]
      }
    },
    {
      "id": "password-field",
      "description": "Password field, masked on input",
      "signals": [
        "[\"']password[\"']"
      ],
      "criteria": {
        "wcag-2.2": [
          "3.3.8"
        ],
        "rgaa-4.1.2": []
      }
    },
    {
      "id": "required-field",
      "description": "Required field, marked or checked as such",
      "signals": [
        "\\brequired\\b|aria-required|REQUIRED|[Oo]bligatoire|\\brequis\\b|value === ''"
      ],
      "criteria": {
        "wcag-2.2": [
          "1.3.1",
          "3.3.2"
        ],
        "rgaa-4.1.2": [
          "11.10"
        ]
      }
    },
    {
      "id": "user-information",
      "description": "Field that collects information about the user, among the input purposes of WCAG 2.2 section 7",
      "signals": [
        "auto[Cc]omplete=",
        "type=[\"'](?:email|tel|url|password)[\"']",
        "name=[\"'](?:name|given-name|family-name|username|email|tel|street-address|postal-code|country|bday)[\"']"
      ],
      "criteria": {
        "wcag-2.2": [
          "1.3.5"
        ],
        "rgaa-4.1.2": [
          "11.13"
        ]
      }
    },
    {
      "id": "script-button",
      "description": "Button driven by a script, including toggles and buttons that only contain an image",
      "signals": [
        "type=[\"']button[\"']",
        "role=[\"']button[\"']",
        "aria-pressed",
        "onClick="
      ],
      "criteria": {
        "wcag-2.2": [
          "4.1.2"
        ],
        "rgaa-4.1.2": [
          "7.1",
          "7.3"
        ]
      }
    },
    {
      "id": "submit-button",
      "description": "Button that submits or resets a form",
      "signals": [
        "<button(?![^>]*type=[\"']button[\"'])",
        "type=[\"'](?:submit|reset)[\"']"
      ],
      "criteria": {
        "wcag-2.2": [
          "2.5.3",
          "4.1.2"
        ],
        "rgaa-4.1.2": [
          "11.9"
        ]
      }
    },
    {
      "id": "field-error",
      "description": "Error message of a field, or the native validation of the browser",
      "signals": [
        "aria-invalid|aria-errormessage|[Ee]rror|ERROR",
        "type=[\"'](?:email|url|number)[\"']",
        "\\b(?:pattern|min|max)="
      ],
      "criteria": {
        "wcag-2.2": [
          "3.3.1"
        ],
        "rgaa-4.1.2": [
          "11.10"
        ]
      }
    },
    {
      "id": "status-message",
      "description": "Message shown after an action without moving focus",
      "signals": [
        "role=[\"'](?:alert|status|log|progressbar)[\"']",
        "aria-live"
      ],
      "criteria": {
        "wcag-2.2": [
          "4.1.3"
        ],
        "rgaa-4.1.2": [
          "7.5"
        ]
      }
    }
  ]
}
