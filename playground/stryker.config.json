{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.tsx",
    "!src/**/*.test.tsx",
    "!src/main.tsx"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "tsconfigFile": "tsconfig.stryker-none.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
